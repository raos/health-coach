# ── Claude AI ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_EXPIRE_DAYS=30
# Optional: restrict login to one Google account; leave empty to allow any
ALLOWED_EMAIL=

# ── Strava OAuth2 ─────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/auth/callback

# ── Garmin Connect ────────────────────────────────────────────────────────────
# Note: if MFA is enabled on your Garmin account (it cannot be disabled),
# the Settings page will prompt for a one-time OTP after each session expiry.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Directory to persist Garmin OAuth tokens across restarts.
# Local:   GARMIN_SESSION_DIR=./garmin_session
# Railway: GARMIN_SESSION_DIR=/data/garmin_session  (persistent volume)
GARMIN_SESSION_DIR=./garmin_session

# ── Hevy ──────────────────────────────────────────────────────────────────────
# API key from https://hevy.com → Settings → Developer
HEVY_API_KEY=

# ── MCP Remote Server ─────────────────────────────────────────────────────────
# Lets Claude.app (iOS/Android/Desktop) log meals, query health data, sync
# workouts, and more over a secure remote MCP connection.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# Then add to Claude Desktop config (~/Library/Application Support/Claude/claude_desktop_config.json):
#   { "mcpServers": { "health-coach": { "command": "npx", "args": ["-y",
#     "mcp-remote@latest", "https://<host>/mcp/sse?key=<MCP_API_KEY>"] } } }
# The full SSE URL is shown in the app under Settings → Mobile Access.
MCP_API_KEY=

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used to email meal plans, training plans, and shopping lists as PDFs.
# Get a free API key at https://resend.com
RESEND_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Local:   sqlite:///./health.db
# Railway: sqlite:////data/health.db  (persistent volume mounted at /data)
DATABASE_URL=sqlite:///./health.db

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
# Local:      http://localhost:5173
# Production: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
# Used for post-OAuth redirects back to the frontend
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
