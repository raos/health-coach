# ── Claude AI ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_EXPIRE_DAYS=30

# ── Multi-tenant admin bootstrap ──────────────────────────────────────────────
# First login with this email gets is_admin=True and skips the onboarding wizard.
# No invite code required for this email. Required for initial setup.
ADMIN_EMAIL=

# Legacy single-user gate — only respected when ADMIN_EMAIL is NOT set.
# Leave empty in multi-tenant mode.
ALLOWED_EMAIL=

# ── Strava OAuth2 ─────────────────────────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/auth/callback

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Required for magic link authentication and weekly summary emails.
# Optional for meal plan / shopping list emails.
# Get a free API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Health Coach <onboarding@resend.dev>

# ── Database ──────────────────────────────────────────────────────────────────
# Local:      postgresql://localhost/health_coach_dev
# Railway:    provided automatically by Railway PostgreSQL plugin
DATABASE_URL=postgresql://localhost/health_coach_dev

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
# Local:      http://localhost:5173
# Production: http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173
# Used for post-OAuth redirects back to the frontend
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# ── MCP push-data backwards-compat ────────────────────────────────────────────
# Only needed if you use the /api/garmin/push-data endpoint with the old global key.
# Per-user MCP keys are stored in UserProfile and are the primary auth mechanism.
MCP_API_KEY=
