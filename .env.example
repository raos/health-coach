# Claude AI
ANTHROPIC_API_KEY=sk-ant-...

# Google OAuth2 (https://console.cloud.google.com/)
# 1. Create a project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# 2. Application type: Web application
# 3. Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# JWT — generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_EXPIRE_DAYS=30

# Optional: restrict login to a single Google account (your email)
# Leave empty to allow any Google account
ALLOWED_EMAIL=

# Strava OAuth2
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/strava/auth/callback

# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Hevy (API key from https://api.hevyapp.com/docs/#/)
HEVY_API_KEY=

# Database
DATABASE_URL=sqlite:///./health.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Optional: MyFitnessPal (unofficial)
MFP_USERNAME=
MFP_PASSWORD=
